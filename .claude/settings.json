{
  "permissions": {
    "allow": [
      "Bash(task *)",
      "Bash(mise *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(shasum *)",
      "Bash(python *)",
      "Bash(pytest *)",
      "Bash(ruff *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // \"\"' | { read -r f; case \"$f\" in *.py) cd \"$(git rev-parse --show-toplevel 2>/dev/null)\" 2>/dev/null && mise exec -- task check >/dev/null 2>&1 || true ;; esac; } 2>/dev/null || true",
            "statusMessage": "Running task check (lint + tests)..."
          }
        ]
      }
    ]
  }
}
